# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Required ---

# Groq API key used by every LLM agent (https://console.groq.com)
GROQ_API_KEY=

# PostgreSQL connection string used by the LangGraph checkpointer.
# sslmode=require is appended automatically when missing.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Required for live data (agents degrade gracefully without them) ---

# Tavily search (hotel agent) - https://tavily.com
TAVILY_API_KEY=

# AviationStack (flight agent) - https://aviationstack.com
AVIATION_STACK_API_KEY=

# OpenWeather (weather agent) - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Optional server settings ---

# TRIPMATE_HOST=127.0.0.1
# TRIPMATE_PORT=8000
# TRIPMATE_LOG_LEVEL=INFO
# TRIPMATE_GROQ_MODEL=llama-3.3-70b-versatile
